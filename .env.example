# Copia este archivo a .env (no se versiona). Para correr en local no hace falta cambiar nada:
# el perfil `local` trae estos mismos valores por defecto.

# --- Base de datos (docker-compose.yml) ---
GESEDU_DB_PORT=5432
POSTGRES_PASSWORD=postgres

# Los roles gesedu_migrador y gesedu_app los crea infra/postgres/init/01-roles-y-bd.sql con estas
# credenciales SOLO PARA DESARROLLO LOCAL. En AWS se crean con los valores reales (docs/despliegue/aws.md).
GESEDU_DB_URL=jdbc:postgresql://localhost:5432/gesedu
GESEDU_DB_APP_USER=gesedu_app
GESEDU_DB_APP_PASSWORD=gesedu_app
GESEDU_DB_MIGRATOR_USER=gesedu_migrador
GESEDU_DB_MIGRATOR_PASSWORD=gesedu_migrador

# --- Seguridad ---
# Clave HS256 del JWT: mínimo 32 caracteres (256 bits). Cambiar siempre fuera del entorno local.
GESEDU_JWT_SECRET=cambia-esta-clave-solo-para-desarrollo-local-0123456789
# Minutos de vigencia del token de acceso (arquitectura: 15) y del bloqueo tras 5 intentos fallidos
GESEDU_JWT_MINUTOS=15
GESEDU_BLOQUEO_MINUTOS=15

# --- Zona horaria y parámetros de asistencia (DA-10) ---
# Si el corte de tardanza de alumnos no es anterior al cierre de la jornada, la aplicación no arranca.
GESEDU_TIME_ZONE=America/Lima
GESEDU_ASISTENCIA_TEACHER_LATE_THRESHOLD_MINUTES=5
GESEDU_ASISTENCIA_STUDENT_LATE_CUTOFF_TIME=08:30
GESEDU_ASISTENCIA_SCHOOL_DAY_CLOSING_TIME=15:30

# --- Frontend ---
# Origen de la SPA en desarrollo (Vite hace proxy de /api hacia el backend)
GESEDU_WEB_ORIGIN=http://localhost:5173
